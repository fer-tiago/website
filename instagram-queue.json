---
layout: null
---
[
  {% assign design_posts = site.posts | where_exp: "item", "item.tags contains 'design'" | sort: "date" %}
  {% assign valid_posts = "" | split: "" %}
  {% for post in design_posts %}
    {% unless post.cover_image contains ".gif" %}
      {% assign valid_posts = valid_posts | push: post %}
    {% endunless %}
  {% endfor %}
  {% for post in valid_posts %}
  {
    "id": {{ post.url | remove: ".html" | jsonify }},
    "title": {{ post.title | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "cover_image": {{ post.cover_image | jsonify }},
    "url": {{ post.url | absolute_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
