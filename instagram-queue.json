---
layout: null
---
[
  {% assign design_posts = site.posts | where_exp: "item", "item.tags contains 'design'" | sort: "date" %}
  {% for post in design_posts %}
  {
    "id": {{ post.url | jsonify }},
    "title": {{ post.title | jsonify }},
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "cover_image": {{ post.cover_image | jsonify }},
    "url": "{{ post.url | absolute_url }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
