---
layout: null
---
[
  {% assign sorted_posts = site.posts | sort: "date" %}
  {% assign valid_posts = "" | split: "" %}
  {% for post in sorted_posts %}
    {% if post.tags contains 'design' or post.tags contains 'art' %}
      {% unless post.cover_image contains ".gif" %}
        {% assign valid_posts = valid_posts | push: post %}
      {% endunless %}
    {% endif %}
  {% endfor %}
  {% for post in valid_posts %}
  {
    "id": {{ post.url | remove: ".html" | jsonify }},
    "title": {{ post.title | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "display_date": {{ post.date | date: "%d.%m.%Y" | jsonify }},
    "cover_image": {{ post.cover_image | jsonify }},
    "url": {{ post.url | absolute_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
